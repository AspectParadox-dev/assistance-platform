DATABASE_URL="postgresql://user:password@localhost:5432/assistance_platform"
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"
PORT=3000
NODE_ENV="development"

# ── CORS / Origin ────────────────────────────────────────────────────────────
# The URL of the frontend — used for CORS allow-origin in app.js.
# In production set this to your actual frontend domain (e.g. https://app.example.com).
FRONTEND_URL="http://localhost:5173"

# ── File Storage ────────────────────────────────────────────────────────────
# STORAGE_BACKEND: "local" (default) or "s3"
STORAGE_BACKEND="local"
UPLOAD_DIR="./uploads"

# Required only when STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""

# ── Email Notifications ─────────────────────────────────────────────────────
# Set EMAIL_ENABLED=true to activate. Leave false in development to suppress all sends.
EMAIL_ENABLED="false"
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE="false"     # true for port 465 (SSL), false for 587 (STARTTLS)
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@yourorg.org"
APP_URL="http://localhost:5173"

# ── Compliance Automation ───────────────────────────────────────────────────
# Maximum "reasonable" requested amount for the amount_reasonable auto-check rule
MAX_REASONABLE_AMOUNT=10000
