DATABASE_URL="postgresql://user:password@localhost:5432/assistance_platform"
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"
PORT=3000
NODE_ENV="development"

# ── CORS / Origin ────────────────────────────────────────────────────────────
# The URL of the frontend — used for CORS allow-origin in app.js.
# In production set this to your actual frontend domain (e.g. https://app.example.com).
FRONTEND_URL="http://localhost:5173"

# ── File Storage ────────────────────────────────────────────────────────────
# STORAGE_BACKEND: "local" (default) or "s3"
STORAGE_BACKEND="local"
UPLOAD_DIR="./uploads"

# Required only when STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""

# ── Email Notifications ─────────────────────────────────────────────────────
# Sign up at https://app.mailjet.com → Account Settings → REST API → API Key Management
# Then go to Senders & Domains → Add a sender email and verify it.
# Leave blank to disable all email sends (app still works fine without it).
MAILJET_API_KEY=""
MAILJET_SECRET_KEY=""
EMAIL_FROM="arshanwari03@gmail.com"
EMAIL_FROM_NAME="Assistance Platform"
APP_URL="http://localhost:5173"

# ── Google Sign-In ──────────────────────────────────────────────────────────
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/
# Set the Authorised JavaScript origins to your frontend URL (e.g. http://localhost:5173)
# Leave empty to disable the Google Sign-In button entirely
GOOGLE_CLIENT_ID=""

# ── Compliance Automation ───────────────────────────────────────────────────
# Maximum "reasonable" requested amount for the amount_reasonable auto-check rule
MAX_REASONABLE_AMOUNT=10000
